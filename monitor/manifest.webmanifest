{
  "name": "KEDEN44 — Монитор статусов ДТ",
  "short_name": "KEDEN44",
  "start_url": "/monitor/",
  "scope": "/monitor/",
  "display": "standalone",
  "background_color": "#f7f8fb",
  "theme_color": "#2563eb",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "pdfs",
          "accept": ["application/pdf", ".pdf"]
        }
      ]
    }
  },
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
